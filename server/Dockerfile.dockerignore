# Repository metadata and local agent state are never runtime inputs.
.git
.git/**
**/.git
**/.git/**
.agents
.agents/**
.codex
.codex/**
.superpowers
.superpowers/**

# Keep credentials and local environment overrides out of the build context.
.env
.env.*
**/.env
**/.env.*
**/.envrc
**/.netrc
**/.npmrc
**/.pypirc
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/credentials.json
**/*-credentials.json
**/service-account*.json

# Preserve checked-in configuration templates.
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example

# Persistent runtime state must come from the configured project volume.
server/history
server/history/**

# The dashboard has its own image and build context.
server/dashboard/node_modules
server/dashboard/node_modules/**
server/dashboard/.next
server/dashboard/.next/**
server/dashboard/out
server/dashboard/out/**
server/dashboard/dist
server/dashboard/dist/**
server/dashboard/build
server/dashboard/build/**
server/dashboard/coverage
server/dashboard/coverage/**
server/dashboard/.turbo
server/dashboard/.turbo/**
server/dashboard/.cache
server/dashboard/.cache/**

# Test support and generated language/tool caches are not API runtime data.
server/test-support.Dockerfile
server/docker-compose.categories-test.yaml
server/Dockerfile.dockerignore
server/test_support
server/test_support/**
server/scripts/verify_categories_container.sh
**/__pycache__
**/__pycache__/**
**/*.py[cod]
**/*.tsbuildinfo
**/.pytest_cache
**/.pytest_cache/**
**/.ruff_cache
**/.ruff_cache/**
**/.mypy_cache
**/.mypy_cache/**
**/.tox
**/.tox/**
**/.nox
**/.nox/**
**/.coverage
**/.coverage.*
**/htmlcov
**/htmlcov/**
**/.DS_Store
