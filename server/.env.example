OPENAI_API_KEY=

# Optional: other bundled LLM/embedder providers (set the key for the one you want to use)
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Postgres — POSTGRES_PASSWORD is required; docker-compose will not start without it.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_COLLECTION_NAME=memories

## Authentication and browser origin
# Required whenever authentication is enabled. Generate a unique high-entropy value;
# do not reuse the placeholder or commit the resulting .env file.
JWT_SECRET=
# Optional legacy bootstrap/back-compat credential. Prefer per-account API keys.
ADMIN_API_KEY=
# Local development only. Leave false in production.
AUTH_DISABLED=false
# Optional; defaults to http://localhost:3000. Must be exactly one canonical
# http(s) origin: no path (other than a trailing /), query, fragment, userinfo,
# whitespace, default port, or non-canonical hostname. It is used for CORS
# and one-time invitation links, so set the externally reachable dashboard origin.
DASHBOARD_URL=http://localhost:3000
# Required for the Unraid deployment overlay. Set it to an IPv4 address assigned
# to the Unraid host; PostgreSQL remains on the internal Docker network.
RAM0_HOST_IP=
# Required for the Unraid deployment overlay. Set the externally reachable
# canonical public origins; these are specific to this self-hosted instance.
RAM0_PUBLIC_API_URL=http://localhost:8888
RAM0_DASHBOARD_URL=http://localhost:3000
APP_DB_NAME=mem0_app

# Default LLM and embedder models. Provider must be in BUNDLED_*_PROVIDERS
# (see server/main.py). Override to pin a specific model without editing code.
MEM0_DEFAULT_LLM_MODEL=gpt-5-mini
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small

# Anonymous telemetry. Sends a single onboarding event per install
# (install UUID, email domain, server version, source). No PII.
# Set to false to opt out.
MEM0_TELEMETRY=true

# Days of request_logs history to keep when `make prune-logs` runs.
# Wire the prune command into cron/systemd in production.
REQUEST_LOG_RETENTION_DAYS=30
